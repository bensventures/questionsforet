---
import sprite from '../../rendu/glyphes.svg?raw';
import { creerRng } from '../../model/rng';
import { creerEtat } from '../../model/terrain';
import { avancer } from '../../model/avancer';
import { rendreCarte } from '../../rendu/carte';
import {
  STYLES_ECRAN,
  STYLES_PANNEAU,
  etatsDesSecteurs,
  fenetreVisible,
  rendreEcran,
  rendrePanneau,
  vueDuPanneau,
} from '../../rendu/panneau';
import { getEntries } from 'astro:content';
import Citation from '../Citation.astro';
import { SOURCES_MECANIQUES, SOURCES_POLITIQUES } from '../../lib/sources-simulateur';
import { TYPES } from '../../model/params';
import { glyphe, couleurVegetation } from '../../rendu/palette';
import { STYLES_REJEU } from '../../rendu/rejeu';
import { agrege, jouerLot } from '../../harness/jouer';
import {
  coupuresSeules,
  eclaircieSansProtection,
  extinctionSystematique,
  mixteCompetente,
  neRienFaire,
  toutDebroussailler,
} from '../../harness/strategies';
import { STYLES_OUVERTURE } from '../../rendu/panneau';

/**
 * Simulateur v3, à la place de la v2 gelée.
 *
 * Le **premier été est rendu au serveur** : sans script, la page montre le
 * versant de départ et le panneau, ce qui reste honnête. Avec, l'îlot recrée le
 * même état à la même graine et la partie commence. L'ouverture en plein écran,
 * la bascule des petits écrans et le choix d'échelle restent en CSS ; le script
 * ne sert qu'à décider et à faire passer les étés.
 *
 * **La page est la porte d'entrée, pas le simulateur.** Une carte est un
 * rectangle paysage ; dans le flux d'un article elle n'a qu'une colonne étroite
 * et déborde de la fenêtre en hauteur. Le simulateur s'ouvre donc par-dessus,
 * sans marge, sur toute la fenêtre.
 *
 * La page est celle d'un outil `prive` : construite et servie, mais listée nulle
 * part et en `noindex`. C'est ce qui autorise encore à sortir la carte entière à
 * l'échelle native plutôt qu'une fenêtre. Le HTML pèse 913 Ko, presque tout en
 * SVG, soit 126 Ko une fois compressé : tenable pour une relecture, à régler
 * avant de lister la page.
 */

interface Props {
  /** Graine de la partie rendue. Déterministe : même graine, même image. */
  graine?: number;
  /** Tour auquel on s'arrête. */
  tour?: number;
}
const { graine = 1000 } = Astro.props;

// **Le premier été, rendu au serveur.** L'îlot recrée le même état à la même
// graine et reprend exactement là : sans script, on voit le versant de départ
// et le panneau, ce qui reste une page honnête ; avec, la partie commence.
const etat = creerEtat(graine, creerRng(graine), 40);
const vue = vueDuPanneau(etat, { secteur: null, lignes: [] });
const carte = rendreCarte(etat, {
  // Échelle d'ouverture : le calque est du chrome, sa géométrie suit la
  // réduction pour garder sa taille à l'écran.
  secteurs: { donnees: etatsDesSecteurs(etat), selectionne: null, survole: null, echelle: 3 },
});
const [, , largeurSvg, hauteurSvg] = carte.viewBox.split(' ');

// Cadre de référence de la planche 9, pour la barre de position. L'îlot la
// mettra à jour au défilement ; ici elle vaut pour l'ouverture.
const CADRE = { largeur: 1800, hauteur: 1080 };
const ecran = rendreEcran({
  sprite,
  carte: `<svg viewBox="${carte.viewBox}" width="${largeurSvg}" height="${hauteurSvg}">${carte.contenu}</svg>`,
  panneau: rendrePanneau(vue),
  largeur: etat.largeur,
  hauteur: etat.hauteur,
  vue: fenetreVisible(CADRE),
  // On entre sur le paysage ; on se rapproche ensuite.
  echelle: 'moyenne',
});

/**
 * Légende, engendrée depuis la palette du rendu : les couverts que la carte
 * dessine, avec le nom que le modèle leur donne. Rien n'est recopié à la main,
 * donc rien ne peut mentir sur ce que le joueur verra.
 */
const LEGENDE = [
  'chene', 'hetre', 'pinNoir', 'pinSylvestre',
  'garrigue', 'friche', 'pelouse', 'ripisylve', 'rocher', 'bati',
] as const;
const legende = LEGENDE.map((type) => ({
  nom: TYPES[type].nom,
  href: glyphe(type, 3, 'sain'),
  couleur: couleurVegetation(type, 3),
}));
/** Deux états qu'on ne lit qu'après un feu, et qui racontent le plus. */
const legendeFeu = [
  { nom: 'Houppier roussi', href: glyphe('chene', 3, 'roussi'), couleur: couleurVegetation('chene', 2) },
  { nom: 'Souche à rejet', href: glyphe('chene', 3, 'consomme'), couleur: null },
  { nom: 'Pin mort, sans retour', href: glyphe('pinNoir', 3, 'consomme'), couleur: null },
  { nom: 'Construction détruite', href: glyphe('bati', 3, 'sain', 'ruine'), couleur: null },
];

/**
 * Six façons de jouer, et ce qu'elles donnent. **Les parties sont jouées au
 * build**, par le harnais qui sert à calibrer le modèle : les chiffres ne sont
 * pas recopiés, ils sont produits par le même noyau que la partie du lecteur,
 * et ils bougent le jour où le modèle bouge. C'est la règle de la légende, une
 * couche plus loin.
 *
 * Cinquante parties par stratégie, comme la calibration, et quarante étés
 * chacune : moins d'une seconde et demie de build pour six colonnes qui ne
 * peuvent pas mentir.
 *
 * La description dit ce que la stratégie fait, et rien de plus : elle doit
 * pouvoir se vérifier ligne à ligne dans `src/harness/strategies.ts`.
 */
const FACONS = [
  {
    strat: neRienFaire,
    nom: 'Ne rien faire',
    fait: 'Aucune politique, aucun geste. Le territoire garde la doctrine choisie au premier été et laisse venir.',
  },
  {
    strat: eclaircieSansProtection,
    nom: 'Éclaircir la forêt partout',
    fait: 'Un programme d’éclaircie dans tous les secteurs qui l’admettent, y compris ceux où l’opération perd de l’argent. Rien pour les constructions.',
  },
  {
    strat: coupuresSeules,
    nom: 'Compartimenter le paysage',
    fait: 'Un contrat pastoral et un programme d’éclaircie, sur un secteur chacun. On travaille la végétation, on ne touche pas au bâti.',
  },
  {
    strat: toutDebroussailler,
    nom: 'Débroussailler large',
    fait: 'Le contrôle des obligations partout où il s’applique, plus deux contrats pastoraux. Le périmètre des maisons, et rien sur les maisons elles-mêmes.',
  },
  {
    strat: extinctionSystematique,
    nom: 'Éteindre tout départ',
    fait: 'La posture héritée tenue quarante étés, sans jamais la réformer et sans rien engager d’autre.',
  },
  {
    strat: mixteCompetente,
    nom: 'Jouer serré',
    fait: 'Durcir le bâti d’abord, contrôler les obligations sur la couronne la plus habitée, entretenir le paysage ensuite, et réformer la doctrine dans la fenêtre qu’ouvre le premier incendie.',
  },
];
const PARTIES = 50;
const facons = FACONS.map(({ strat, nom, fait }) => {
  const r = jouerLot(strat, PARTIES);
  return {
    nom,
    fait,
    chiffres: [
      { quoi: 'constructions debout', valeur: `${agrege(r, 'batiPct').toFixed(0)} %` },
      { quoi: 'versant parcouru par le feu', valeur: `${agrege(r, 'bruleePct').toFixed(0)} %` },
      { quoi: 'friche à graminées', valeur: `${agrege(r, 'frichePct').toFixed(0)} %` },
      { quoi: 'dépensé en quarante étés', valeur: agrege(r, 'depense').toFixed(0) },
      {
        quoi: 'programmes abandonnés faute de moyens',
        valeur: agrege(r, 'renoncementsModele').toFixed(1).replace('.', ','),
      },
    ],
  };
});

// Les sources, mécanisme par mécanisme : l'objet le plus argumenté du site ne
// peut pas être le seul sans traçabilité.
const mecanismes = await Promise.all(
  [...Object.values(SOURCES_POLITIQUES), ...SOURCES_MECANIQUES].map(async (m) => ({
    ...m,
    resolues: await getEntries(m.ids.map((id) => ({ collection: 'sources' as const, id }))),
  })),
);
---

<section class="v3" aria-label="Simulateur, aperçu statique">
  <p class="v3__note">
    Le simulateur s'ouvre sur toute la fenêtre. On tire la carte pour s'y déplacer, et trois
    échelles sont proposées, chacune disant ce qu'elle perd. Chaque versant porte un numéro : le
    même numéro redonne le même terrain.
  </p>

  <p class="v3__cta"><a href="#simulateur">Ouvrir le simulateur</a></p>

  <h2 class="v3__h">Ce que la carte montre</h2>
  <p class="v3__note">
    Une parcelle vaut 50 m de côté. Le nombre d'arbres dit la densité du peuplement, le semis de
    points au sol dit la charge de sous-bois, et l'espacement des courbes dit la pente.
  </p>
  <ul class="v3__legende">
    {legende.map((g) => (
      <li>
        <svg viewBox="0 0 64 96" aria-hidden="true" style={g.couleur ? `color:${g.couleur}` : undefined}>
          <use href={`#${g.href}`} />
        </svg>
        <span>{g.nom}</span>
      </li>
    ))}
  </ul>
  <p class="v3__note">Après le feu, le paysage garde sa trace, et chacune s'efface à son rythme.</p>
  <ul class="v3__legende">
    {legendeFeu.map((g) => (
      <li>
        <svg viewBox="0 0 64 96" aria-hidden="true" style={g.couleur ? `color:${g.couleur}` : undefined}>
          <use href={`#${g.href}`} />
        </svg>
        <span>{g.nom}</span>
      </li>
    ))}
  </ul>
  <Fragment set:html={sprite} />

  <h2 class="v3__h">Six façons de jouer, et ce qu'elles donnent</h2>
  <p class="v3__note">
    Six lignes de conduite jouées par la machine, {PARTIES} parties de quarante étés chacune, sur
    des versants tirés au hasard. Ces moyennes sortent du modèle que vous allez manipuler : ce
    sont les conséquences de ses règles, pas des observations de terrain.
  </p>
  <ol class="v3__jeux">
    {facons.map((f) => (
      <li>
        <h3>{f.nom}</h3>
        <p>{f.fait}</p>
        <dl>
          {f.chiffres.map((c) => (
            <div>
              <dt>{c.valeur}</dt>
              <dd>{c.quoi}</dd>
            </div>
          ))}
        </dl>
      </li>
    ))}
  </ol>
  <p class="v3__note">
    Les deux premières lignes se valent, et c'est ce que le tableau a de plus utile : éclaircir
    la forêt partout coûte deux fois plus cher que ne rien faire, pour le même nombre de maisons
    debout. Le peuplement s'ouvre pourtant, et le feu parcourt moins de terrain. Deux raisons à ce
    surplace. L'éclaircie est déficitaire en terrain raide et éloigné, si bien que les programmes
    s'ouvrent et se referment faute de moyens, quatorze fois par partie. Et rien de ce qu'elle
    achète ne protège une construction. Gérer la forêt et protéger les maisons sont deux métiers ;
    le second se joue dans les cinquante mètres autour du bâti.
  </p>

  <h2 class="v3__h">Ce sur quoi le modèle s'appuie</h2>
  <p class="v3__note">
    Chaque levier applique une règle, et chaque règle vient de quelque part. Les mécaniques que
    personne ne décide sont sourcées au même titre que les leviers.
  </p>
  <dl class="v3__mecanismes">
    {mecanismes.map((m) => (
      <div>
        <dt>{m.nom}</dt>
        <dd>
          <p>{m.regle}</p>
          <ol>
            {m.resolues.map((s) => (
              <li><Citation source={s.data} /></li>
            ))}
          </ol>
        </dd>
      </div>
    ))}
  </dl>
</section>

<div id="simulateur" class="plein" data-graine={graine}>
  <Fragment set:html={ecran} />
  <a class="plein__fermer" href="#simulateur-ferme">Fermer</a>
</div>

<script>
  import { monterSimulateur } from '../../ilot/simulateur';

  /**
   * Déplacement de la carte **au curseur**, à la manière d'une carte en ligne.
   * Se déplacer aux deux barres de défilement sur un plan de 40 × 26 parcelles
   * est pénible, et aucune mise en page ne le rattrape.
   *
   * Le clavier n'est pas oublié : la boîte de défilement reste focalisable et
   * les flèches continuent de la déplacer, ce que ce script ne touche pas.
   */
  for (const boite of document.querySelectorAll<HTMLElement>('.ecran__carte')) {
    let x = 0;
    let y = 0;
    let gauche = 0;
    let haut = 0;

    boite.addEventListener('pointerdown', (e) => {
      // Bouton principal seulement : le secondaire ouvre le menu du navigateur.
      if (e.button !== 0) return;
      x = e.clientX;
      y = e.clientY;
      gauche = boite.scrollLeft;
      haut = boite.scrollTop;
      boite.dataset.tire = '';
      boite.setPointerCapture(e.pointerId);
    });

    boite.addEventListener('pointermove', (e) => {
      if (!('tire' in boite.dataset)) return;
      boite.scrollLeft = gauche - (e.clientX - x);
      boite.scrollTop = haut - (e.clientY - y);
    });

    for (const fin of ['pointerup', 'pointercancel']) {
      boite.addEventListener(fin, () => delete boite.dataset.tire);
    }
  }

  // La partie prend la main sur l'écran rendu au serveur, à la même graine.
  const plein = document.querySelector<HTMLElement>('#simulateur');
  const graine = Number(plein?.dataset.graine ?? 1000);
  if (plein) monterSimulateur(plein, graine);
</script>

<style is:global set:html={STYLES_PANNEAU + STYLES_ECRAN + STYLES_REJEU + STYLES_OUVERTURE}></style>

<style>
  .v3 {
    margin: 2rem 0 3rem;
  }
  .v3__note {
    max-width: 42rem;
    margin: 0 0 1rem;
    font-size: 0.92rem;
    color: var(--ink-2, #5a5148);
  }
  .v3__cta {
    margin: 1.5rem 0 0;
  }
  .v3__cta a {
    display: inline-block;
    padding: 0.7rem 1.4rem;
    background: var(--ember, oklch(0.48 0.16 44));
    color: oklch(0.96 0.014 88);
    text-decoration: none;
    font-size: 0.95rem;
    letter-spacing: 0.02em;
  }
  .v3__h {
    margin: 2.5rem 0 0.5rem;
    font-size: 1.1rem;
  }
  /* Légende : les glyphes à leur taille de lecture, pas à celle de la carte. */
  .v3__legende {
    display: flex;
    flex-wrap: wrap;
    gap: 1.2rem 1.6rem;
    margin: 0 0 1.6rem;
    padding: 0;
    list-style: none;
  }
  /* Les glyphes sont dessinés le pied au bas de leur gabarit : les aligner par
     le bas leur rend leur ligne de sol commune, comme sur la carte. */
  .v3__legende li {
    display: flex;
    align-items: flex-end;
    gap: 0.5rem;
    font-size: 0.9rem;
    line-height: 1.2;
  }
  .v3__legende svg {
    width: 34px;
    height: 51px;
    flex: 0 0 34px;
  }
  /* Six façons de jouer. Une liste de blocs plutôt qu'un tableau : cinq
     colonnes de chiffres dans une colonne d'article se lisent en travers, et
     l'ordre du classement se perd au premier écran étroit. */
  .v3__jeux {
    margin: 0 0 1.6rem;
    padding: 0;
    list-style: none;
    max-width: 46rem;
    counter-reset: facon;
  }
  .v3__jeux > li + li {
    margin-top: 1.4rem;
    border-top: 1px solid var(--rule, #d8cfc0);
    padding-top: 1.4rem;
  }
  .v3__jeux h3 {
    margin: 0;
    font-size: 1.05rem;
  }
  .v3__jeux p {
    margin: 0.3rem 0 0.7rem;
    color: var(--ink-2, #5a5148);
    font-size: 0.95rem;
  }
  .v3__jeux dl {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem 1.6rem;
    margin: 0;
  }
  .v3__jeux dt {
    font-family: var(--font-display, Fraunces), serif;
    font-size: 1.35rem;
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }
  .v3__jeux dd {
    margin: 0.15rem 0 0;
    font-size: 0.8rem;
    color: var(--ink-2, #5a5148);
    max-width: 9rem;
  }
  .v3__mecanismes {
    margin: 0;
    max-width: 46rem;
  }
  .v3__mecanismes > div + div {
    margin-top: 1.4rem;
    border-top: 1px solid var(--rule, #d8cfc0);
    padding-top: 1.4rem;
  }
  .v3__mecanismes dt {
    font-weight: 600;
    font-size: 1rem;
  }
  .v3__mecanismes dd {
    margin: 0.3rem 0 0;
  }
  .v3__mecanismes dd p {
    margin: 0 0 0.6rem;
    color: var(--ink-2, #5a5148);
    font-size: 0.95rem;
  }
  .v3__mecanismes ol {
    margin: 0;
    padding-left: 1.2rem;
    display: grid;
    gap: 0.35rem;
    font-size: 0.9rem;
  }
</style>
