---
import { getEntries, type CollectionEntry } from 'astro:content';
import Citation from '../Citation.astro';
import { TOOLS } from '../../sim/params';
import { POLICIES } from '../../sim/policies';

interface Props {
  /** The full resolved model bibliography (from the page frontmatter). */
  modelSources: CollectionEntry<'sources'>[];
}
const { modelSources } = Astro.props;

// Server-rendered "sources du modèle" panel: each lever mapped to the
// references it is drawn from. Ids come from src/sim/params.ts and must all be
// present in the page frontmatter `sources` (so reference() validates them).
const resolve = (ids: string[]) =>
  getEntries(ids.map((id) => ({ collection: 'sources' as const, id })));

const toolsWithSources = await Promise.all(
  [...POLICIES, ...TOOLS].map(async (t) => ({
    nm: t.nm,
    gl: t.gl,
    sources: await resolve(t.sources),
  })),
);

// Sources behind the model's automatic mechanics (embers, closure, regime),
// i.e. those not attached to a single lever or policy.
const toolIds = new Set([...POLICIES, ...TOOLS].flatMap((t) => t.sources));
const extras = modelSources.filter((s) => !toolIds.has(s.id));
---

<section class="sim-wrap" aria-label="Simulateur">
  <div class="sim" data-sim>
    <div class="sim__main">
      <div class="sim__maptop">
        <span>Année <b data-sim-year>1</b> / <span data-sim-max>45</span></span>
        <div class="sim__gauge">
          <span>Indice sécheresse</span>
          <div class="bar"><div class="needle" data-sim-needle style="left:35%"></div></div>
          <span data-sim-drought>0.35</span>
        </div>
        <span>Points d'action <b data-sim-pa>8</b></span>
        <button class="sim__viewbtn" type="button" data-sim-sectors aria-pressed="false">Secteurs</button>
      </div>

      <div class="sim__mapbox"><canvas data-sim-cv></canvas></div>

      <div class="sim__readout">
        <div><div class="k">Bâti intact</div><div class="v"><span data-sim-bati>0</span><small>/<span data-sim-batit>0</span></small></div></div>
        <div><div class="k">Paysage fermé</div><div class="v"><span data-sim-closed>0</span><small>%</small></div></div>
        <div><div class="k">Biodiversité</div><div class="v" data-sim-bio>0</div></div>
        <div><div class="k">Brûlé cumulé</div><div class="v"><span data-sim-brul>0</span><small>%</small></div></div>
        <div><div class="k">Foyers sinistrés</div><div class="v" data-sim-perte>0</div></div>
      </div>

      <div class="sim__panel">
        <h2>Légende</h2>
        <div class="sim__legend" data-sim-legend></div>
      </div>
    </div>

    <div class="sim__side">
      <button class="sim__go" data-sim-go>Passer à l'été →</button>
      <div class="sim__panel sim__panel--doctrine">
        <h2>Doctrine de lutte</h2>
        <div class="sim__crans" data-sim-doctrine></div>
      </div>
      <div class="sim__accept">
        <div class="sim__accept-top">
          <span>Acceptabilité sociale</span><b><span data-sim-accept>60</span> ⌾</b>
        </div>
        <div class="sim__accept-bar"><span data-sim-acceptbar style="width:60%"></span></div>
      </div>

      <div class="sim__panel">
        <h2>
          <span>Politiques</span>
          <span class="sim__h2r">
            <button class="sim__info" type="button" data-sim-info aria-label="Sources du modèle" title="Sources du modèle">i</button>
            <b data-sim-patag>8 PA</b>
          </span>
        </h2>
        <p class="sim__panelnote">Une politique se désigne sur un secteur : choisissez-la, puis cliquez la zone sur la carte.</p>
        <div class="sim__tools" data-sim-pols></div>
      </div>

      <div class="sim__panel">
        <h2>En vigueur</h2>
        <div class="sim__active" data-sim-active></div>
      </div>

      <div class="sim__panel">
        <h2>Actions ponctuelles</h2>
        <div class="sim__tools" data-sim-tools></div>
      </div>
      <div class="sim__panel">
        <h2>Tableau de bord</h2>
        <div class="sim__dash" data-sim-dash></div>
      </div>
      <div class="sim__panel">
        <h2>Journal</h2>
        <div class="sim__log" data-sim-log></div>
      </div>
      <button class="sim__sourceslink" type="button" data-sim-info>Sources du modèle</button>
    </div>

    <div class="sim__veil" data-sim-veil hidden><div class="sim__card" data-sim-card></div></div>
    <div class="sim__pane" data-sim-pane hidden>
      <div class="sim__pane-card" data-sim-pane-card>
        <button class="sim__pane-close" type="button" data-sim-pane-close aria-label="Fermer">Fermer ✕</button>
      </div>
    </div>
    <div class="sim__tip" data-sim-tip role="status" hidden></div>
  </div>

  <!-- Repli lisible si le script ne se charge pas (garde-fou du brief §11). -->
  <p class="sim-fallback" data-sim-fallback>
    Ce simulateur a besoin de JavaScript. Le texte ci-dessus décrit ce qu'il met
    en jeu ; les mécaniques et leurs sources sont listées ci-dessous.
  </p>

  <section class="sim-sources" data-sim-sources aria-labelledby="sim-sources-titre">
    <h2 id="sim-sources-titre">Sources du modèle</h2>
    <p class="sim-sources__intro">
      Chaque levier traduit un résultat de la littérature. Les valeurs du modèle
      sont des ordres de grandeur de jeu, calibrés pour produire des dynamiques
      justes, non des prédictions : rien ici ne vaut diagnostic pour une parcelle
      réelle, et les distances applicables relèvent de la réglementation locale.
    </p>
    <ul class="sim-sources__list" role="list">
      {
        toolsWithSources.map((t) => (
          <li>
            <p class="sim-sources__lever"><span aria-hidden="true">{t.gl}</span> {t.nm}</p>
            <div class="sim-sources__cites">
              {t.sources.map((s) => (
                <Citation source={s.data} compact />
              ))}
            </div>
          </li>
        ))
      }
      {
        extras.length > 0 && (
          <li>
            <p class="sim-sources__lever">
              <span aria-hidden="true">◆</span> Ressorts automatiques (braises, fermeture, régime de feu)
            </p>
            <div class="sim-sources__cites">
              {extras.map((s) => (
                <Citation source={s.data} compact />
              ))}
            </div>
          </li>
        )
      }
    </ul>
  </section>
</section>

<script>
  import { mount } from '../../sim/index';
  const el = document.querySelector<HTMLElement>('[data-sim]');
  const fb = document.querySelector<HTMLElement>('[data-sim-fallback]');
  if (el) {
    if (fb) fb.hidden = true;
    mount(el);
  }
</script>

<style is:global>
  .sim-wrap {
    margin: 1.5rem 0 0;
  }

  .sim {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 300px;
    gap: 1rem;
    align-items: start;
  }
  @media (max-width: 860px) {
    .sim {
      grid-template-columns: 1fr;
    }
  }

  .sim__maptop {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.6rem;
    padding: 0.5rem 0.7rem;
    background: var(--surface);
    border: 1px solid var(--rule);
    border-bottom: none;
    border-radius: 8px 8px 0 0;
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }
  .sim__maptop b {
    color: var(--ink);
    font-variant-numeric: tabular-nums;
  }
  .sim__gauge {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex: 1;
    max-width: 340px;
  }
  .sim__gauge .bar {
    position: relative;
    height: 8px;
    flex: 1;
    border-radius: 2px;
    background: linear-gradient(90deg, #2c5340, #7c9a4e, #d8c672, #b0431c, #7a1f0d);
  }
  .sim__gauge .needle {
    position: absolute;
    top: -4px;
    width: 2px;
    height: 16px;
    background: var(--ink);
    box-shadow: 0 0 0 1px var(--surface);
  }

  .sim__viewbtn {
    flex: none;
    padding: 0.2rem 0.55rem;
    background: var(--paper);
    border: 1px solid var(--rule);
    border-radius: 5px;
    font: inherit;
    font-size: 0.68rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-soft);
    cursor: pointer;
  }
  .sim__viewbtn:hover {
    border-color: var(--ember);
    color: var(--ember);
  }
  .sim__viewbtn[aria-pressed='true'] {
    background: var(--ember);
    border-color: var(--ember);
    color: var(--accent-fg);
  }

  .sim__mapbox {
    background: var(--paper-2);
    border: 1px solid var(--rule);
    overflow: hidden;
  }
  .sim__mapbox canvas {
    display: block;
    width: 100%;
    height: auto;
    cursor: crosshair;
    touch-action: none;
  }

  .sim__readout {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 1px;
    background: var(--rule);
    border: 1px solid var(--rule);
    border-top: none;
    border-radius: 0 0 8px 8px;
    overflow: hidden;
  }
  .sim__readout > div {
    background: var(--surface);
    padding: 0.5rem 0.6rem;
  }
  .sim__readout .k {
    font-size: 0.62rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }
  .sim__readout .v {
    font-family: var(--sans);
    font-variant-numeric: tabular-nums;
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--ink);
    margin-top: 2px;
  }
  .sim__readout .v small {
    font-size: 0.7rem;
    font-weight: 400;
    color: var(--ink-soft);
  }

  .sim__panel {
    background: var(--surface);
    border: 1px solid var(--rule);
    border-radius: 8px;
    margin-top: 0.75rem;
  }
  .sim__main .sim__panel {
    margin-top: 0.75rem;
  }
  .sim__panel h2 {
    margin: 0;
    padding: 0.55rem 0.7rem;
    font-family: var(--sans);
    font-size: 0.68rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-soft);
    font-weight: 700;
    border-bottom: 1px solid var(--rule);
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .sim__panel h2 b {
    color: var(--ember);
    font-variant-numeric: tabular-nums;
  }

  .sim__panel--doctrine {
    margin-top: 0;
    margin-bottom: 0.75rem;
  }
  .sim__crans {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1px;
    padding: 0.35rem;
  }
  .sim-cran {
    display: grid;
    gap: 0.1rem;
    padding: 0.4rem 0.3rem;
    background: var(--paper);
    border: 1px solid var(--rule);
    border-radius: 5px;
    font: inherit;
    color: var(--ink);
    text-align: center;
    cursor: pointer;
  }
  .sim-cran:hover {
    border-color: var(--ember);
  }
  .sim-cran:focus-visible {
    outline: 2px solid var(--ember);
    outline-offset: -2px;
  }
  .sim-cran[aria-pressed='true'] {
    background: var(--ember);
    border-color: var(--ember);
    color: var(--accent-fg);
  }
  .sim-cran .lbl {
    font-size: 0.7rem;
    font-weight: 600;
    line-height: 1.2;
  }
  .sim-cran .cst {
    font-size: 0.62rem;
    font-variant-numeric: tabular-nums;
    color: var(--ink-soft);
  }
  .sim-cran[aria-pressed='true'] .cst {
    color: var(--accent-fg);
    opacity: 0.85;
  }

  .sim__accept {
    padding: 0.5rem 0.7rem;
    background: var(--surface);
    border: 1px solid var(--rule);
    border-radius: 8px;
    margin-bottom: 0.75rem;
  }
  .sim__accept-top {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    font-size: 0.68rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }
  .sim__accept-top b {
    color: var(--pine);
    font-variant-numeric: tabular-nums;
    letter-spacing: 0;
  }
  .sim__accept-bar {
    height: 7px;
    margin-top: 0.3rem;
    background: var(--paper-2);
    border-radius: 4px;
    overflow: hidden;
  }
  .sim__accept-bar > span {
    display: block;
    height: 100%;
    background: var(--pine);
    border-radius: 4px;
    transition: width 0.3s ease;
  }

  .sim__panelnote {
    margin: 0;
    padding: 0.45rem 0.7rem 0;
    font-size: 0.7rem;
    line-height: 1.45;
    color: var(--ink-soft);
  }

  .sim__tools {
    padding: 0.35rem;
  }
  .sim-pol {
    display: grid;
    grid-template-columns: 24px 1fr auto;
    gap: 0.5rem;
    align-items: center;
    width: 100%;
    background: transparent;
    border: 1px solid transparent;
    color: var(--ink);
    text-align: left;
    padding: 0.45rem 0.5rem;
    border-radius: 6px;
    cursor: pointer;
    font: inherit;
  }
  .sim-pol:hover {
    background: var(--paper);
  }
  .sim-pol:focus-visible {
    outline: 2px solid var(--ember);
    outline-offset: -2px;
  }
  .sim-pol[aria-pressed='true'] {
    background: var(--paper);
    border-color: var(--ember);
  }
  .sim-pol:disabled {
    opacity: 0.4;
    cursor: not-allowed;
  }
  .sim-pol .gl {
    width: 24px;
    height: 24px;
    border-radius: 5px;
    display: grid;
    place-items: center;
    font-size: 0.8rem;
    background: var(--paper-2);
    border: 1px solid var(--rule);
  }
  .sim-pol .nm {
    font-size: 0.8rem;
    font-weight: 600;
    line-height: 1.25;
  }
  .sim-pol .zn {
    font-size: 0.66rem;
    color: var(--ink-soft);
  }
  .sim-pol .cost {
    font-variant-numeric: tabular-nums;
    font-size: 0.66rem;
    line-height: 1.35;
    text-align: right;
    color: var(--ink-soft);
  }
  .sim-pol .cost b {
    color: var(--ember);
  }
  .sim-pol .cost i {
    font-style: normal;
    color: var(--pine);
  }

  .sim__active {
    padding: 0.5rem 0.7rem;
    display: grid;
    gap: 0.6rem;
  }
  .sim__active__empty,
  .sim-active__empty {
    margin: 0;
    font-size: 0.72rem;
    line-height: 1.5;
    color: var(--ink-soft);
  }
  .sim-active__top {
    display: flex;
    justify-content: space-between;
    align-items: start;
    gap: 0.4rem;
    font-size: 0.76rem;
    line-height: 1.3;
  }
  .sim-active__top small {
    color: var(--ink-soft);
    font-size: 0.68rem;
  }
  .sim-active__top button {
    flex: none;
    background: none;
    border: none;
    color: var(--ink-soft);
    font: inherit;
    font-size: 0.8rem;
    cursor: pointer;
    padding: 0 0.15rem;
  }
  .sim-active__top button:hover {
    color: var(--ember);
  }
  .sim-active__bar {
    height: 5px;
    margin: 0.25rem 0 0.15rem;
    background: var(--paper-2);
    border-radius: 3px;
    overflow: hidden;
  }
  .sim-active__bar > span {
    display: block;
    height: 100%;
    background: var(--ember);
    border-radius: 3px;
    transition: width 0.3s ease;
  }
  .sim__active small {
    font-size: 0.66rem;
    color: var(--ink-soft);
  }

  .sim-tool {
    display: grid;
    grid-template-columns: 24px 1fr auto;
    gap: 0.5rem;
    align-items: center;
    width: 100%;
    background: transparent;
    border: 1px solid transparent;
    color: var(--ink);
    text-align: left;
    padding: 0.45rem 0.5rem;
    border-radius: 6px;
    cursor: pointer;
    font: inherit;
  }
  .sim-tool:hover {
    background: var(--paper);
  }
  .sim-tool:focus-visible {
    outline: 2px solid var(--ember);
    outline-offset: -2px;
  }
  .sim-tool[aria-pressed='true'] {
    background: var(--paper);
    border-color: var(--ember);
  }
  .sim-tool .gl {
    width: 24px;
    height: 24px;
    border-radius: 5px;
    display: grid;
    place-items: center;
    font-size: 0.8rem;
    background: var(--paper-2);
    border: 1px solid var(--rule);
  }
  .sim-tool .nm {
    font-size: 0.82rem;
    font-weight: 600;
    line-height: 1.25;
  }
  .sim-tool .zn {
    font-size: 0.68rem;
    color: var(--ink-soft);
  }
  .sim-tool .pa {
    font-variant-numeric: tabular-nums;
    font-size: 0.72rem;
    font-weight: 700;
    color: var(--ember);
  }
  .sim-tool:disabled {
    opacity: 0.4;
    cursor: not-allowed;
  }

  .sim__tip {
    position: fixed;
    z-index: 60;
    max-width: 260px;
    padding: 0.6rem 0.75rem;
    background: var(--ink);
    color: var(--paper);
    border-radius: 8px;
    box-shadow: var(--shadow);
    font-size: 0.78rem;
    line-height: 1.5;
    pointer-events: none;
  }
  .sim__tip[hidden] {
    display: none;
  }
  .sim__tip b {
    color: #f0b58c;
  }

  .sim__go {
    position: sticky;
    top: 0.6rem;
    z-index: 5;
    width: 100%;
    margin: 0 0 0.75rem;
    padding: 0.85rem;
    background: var(--ember);
    color: var(--accent-fg);
    border: none;
    border-radius: 8px;
    font: inherit;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    font-size: 0.82rem;
    cursor: pointer;
    box-shadow: var(--shadow);
  }
  .sim__go:hover {
    background: var(--ember-strong);
  }
  .sim__go:disabled {
    background: var(--rule);
    color: var(--ink-soft);
    cursor: wait;
  }

  .sim__toggle {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    width: 100%;
    margin: 0 0 0.75rem;
    padding: 0.55rem 0.75rem;
    background: var(--surface);
    border: 1px solid var(--rule);
    border-radius: 8px;
    font: inherit;
    font-size: 0.82rem;
    color: var(--ink);
    text-align: left;
    cursor: pointer;
  }
  .sim__toggle small {
    color: var(--ink-soft);
  }
  .sim__toggle-box {
    flex: none;
    width: 15px;
    height: 15px;
    border: 1.5px solid var(--ink-soft);
    border-radius: 4px;
    position: relative;
  }
  .sim__toggle[aria-pressed='true'] {
    border-color: var(--ember);
  }
  .sim__toggle[aria-pressed='true'] .sim__toggle-box {
    background: var(--ember);
    border-color: var(--ember);
  }
  .sim__toggle[aria-pressed='true'] .sim__toggle-box::after {
    content: '';
    position: absolute;
    left: 4px;
    top: 1px;
    width: 4px;
    height: 8px;
    border: solid var(--accent-fg);
    border-width: 0 2px 2px 0;
    transform: rotate(45deg);
  }

  .sim-modes {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: 0.5rem;
  }
  .sim__card button.ghost {
    background: transparent;
    border: 1px solid var(--rule);
    color: var(--ink);
  }

  .sim__dash {
    padding: 0.6rem 0.7rem;
    display: grid;
    gap: 0.55rem;
  }
  .sim-ind__top {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    font-size: 0.72rem;
    color: var(--ink-soft);
  }
  .sim-ind__top .trend {
    font-weight: 700;
    color: var(--ink);
  }
  .sim-ind.is-adverse .sim-ind__top,
  .sim-ind.is-adverse .sim-ind__top .trend {
    color: var(--ember);
  }
  .sim-ind__bar {
    position: relative;
    height: 7px;
    margin-top: 0.2rem;
    background: var(--paper-2);
    border-radius: 4px;
  }
  .sim-ind__bar > [data-fill] {
    display: block;
    height: 100%;
    width: 0;
    background: var(--pine);
    border-radius: 4px;
    transition: width 0.3s ease;
  }
  .sim-ind.is-adverse .sim-ind__bar > [data-fill] {
    background: var(--ember);
  }
  .sim-ind__bar .mark {
    position: absolute;
    top: -2px;
    width: 2px;
    height: 11px;
    background: var(--ink);
    opacity: 0.55;
  }

  .sim__log {
    padding: 0.5rem 0.7rem;
    max-height: 210px;
    overflow-y: auto;
    font-size: 0.76rem;
    line-height: 1.45;
  }
  .sim__log p {
    margin: 0 0 0.4rem;
    padding-left: 0.55rem;
    border-left: 2px solid var(--rule);
    color: var(--ink);
  }
  .sim__log p.hot {
    border-color: var(--ember);
  }
  .sim__log p.good {
    border-color: var(--pine);
  }
  .sim__log p.yr {
    border: none;
    padding: 0;
    margin: 0.6rem 0 0.4rem;
    color: var(--ink-soft);
    font-size: 0.66rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .sim__log p:first-child {
    margin-top: 0;
  }

  .sim__legend {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
    gap: 0.35rem 0.9rem;
    padding: 0.7rem 0.8rem;
    font-size: 0.8rem;
    color: var(--ink);
  }
  .sim-legend-item {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
