---
import { TYPE_META, type SourceType } from '../lib/sources';

interface Props {
  type: SourceType;
  /** Show the count in parentheses (used by the legend). */
  count?: number;
}

const { type, count } = Astro.props;
const meta = TYPE_META[type];
---

<span class={`badge badge--${type}`} title={meta.description}>
  {meta.label}{count !== undefined && <span class="badge__count">{count}</span>}
</span>

<style>
  .badge {
    display: inline-flex;
    align-items: baseline;
    gap: 0.35em;
    padding: 0.12em 0.62em;
    border-radius: 3px;
    font-family: var(--sans);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.01em;
    line-height: 1.55;
    white-space: nowrap;
    border: 1px solid var(--badge-border, currentColor);
    background: var(--badge-bg, transparent);
    color: var(--badge-fg, inherit);
  }

  .badge__count {
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    opacity: 0.7;
  }

  /* One colour per type, retuned to sit on warm parchment. Hue signals the
     nature of the source, not a value judgement: a plaidoyer is not "worse",
     it simply carries a stance. */
  .badge--pair {
    --badge-bg: #e2ece0;
    --badge-fg: #285018;
    --badge-border: #bcd0b0;
  }
  .badge--ouvrage {
    --badge-bg: #dfeae7;
    --badge-fg: #235a51;
    --badge-border: #b3ccc5;
  }
  .badge--rapport {
    --badge-bg: #e0e8f0;
    --badge-fg: #2c4d70;
    --badge-border: #b3c5da;
  }
  .badge--institutionnel {
    --badge-bg: #e5e5ef;
    --badge-fg: #3a3d70;
    --badge-border: #bcbdd6;
  }
  .badge--analyse-primaire {
    --badge-bg: #e9e1f0;
    --badge-fg: #573a7c;
    --badge-border: #c9b9dd;
  }
  .badge--vulgarisation {
    --badge-bg: #f4e8c9;
    --badge-fg: #815412;
    --badge-border: #dcc389;
  }
  .badge--plaidoyer {
    --badge-bg: #f2ddd0;
    --badge-fg: #9a3a1c;
    --badge-border: #dcb5a0;
  }
</style>
