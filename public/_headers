# En-têtes HTTP servis par Cloudflare Pages (fichier copié à la racine de dist/).
#
# Le site ne fait aucune requête externe : polices auto-hébergées, aucun script
# tiers, aucune analytique. La CSP peut donc être stricte et le rester : toute
# dépendance externe ajoutée plus tard échouera visiblement ici, ce qui est le
# comportement voulu (garde-fou « pas de dépendance sans nécessité démontrée »).
#
# Deux tolérances, et leurs raisons :
#   style-src 'unsafe-inline' — Astro met en ligne le CSS scoped de chaque page
#     (< 4 ko). S'en passer imposerait des hachages recalculés à chaque build.
#     Le risque est faible : aucune saisie utilisateur n'atteint le HTML.
#   img-src / font-src data: — le grain de papier est un SVG en URI de données
#     dans global.css, et une police courte est encodée en base64 au build.

/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self'; form-action 'none'; frame-ancestors 'none'; base-uri 'self'; object-src 'none'
  Referrer-Policy: strict-origin-when-cross-origin
  X-Content-Type-Options: nosniff
  Permissions-Policy: geolocation=(), camera=(), microphone=(), interest-cohort=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains

# Ressources au nom haché par le build : jamais réécrites, donc immuables.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Les polices portent aussi une empreinte dans leur nom.
/_astro/*.woff2
  Cache-Control: public, max-age=31536000, immutable